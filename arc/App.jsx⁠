
import React, { useState, useEffect } from 'react';
import { 
  Tv, Users, Wallet, CreditCard, Gift, Send, Trophy, Flame, 
  Crown, ShieldCheck, CheckCircle2, Copy, ExternalLink, Mail, 
  UserCheck, Smartphone, DollarSign, Zap
} from 'lucide-react';

export default function App() {
  const [activeTab, setActiveTab] = useState('live');
  const [coins, setCoins] = useState(2500);
  const [points, setPoints] = useState(1200);
  const [copied, setCopied] = useState(false);
  const [showGiftAnimation, setShowGiftAnimation] = useState(null);
  
  const [pkState, setPkState] = useState({
    host1Points: 4500,
    host2Points: 3200,
    timeLeft: 120,
    active: true
  });

  const [targetHost, setTargetHost] = useState(1);
  const [targetUserId, setTargetUserId] = useState('');
  const [transferAmount, setTransferAmount] = useState('');
  const [transferSuccess, setTransferSuccess] = useState(false);

  const [withdrawPoints, setWithdrawPoints] = useState('');
  const [withdrawMethod, setWithdrawMethod] = useState('MoMo');
  const [withdrawDetails, setWithdrawDetails] = useState('');
  const [withdrawSuccess, setWithdrawSuccess] = useState(false);

  const [messages, setMessages] = useState([
    { id: 1, user: 'Sibusiso_SZ', text: 'Eagle Live is lit! 🔥', type: 'chat' },
    { id: 2, user: 'Nomsa_M', text: 'Go Sarah!! Support Host 1! 👑', type: 'chat' },
  ]);
  const [inputMsg, setInputMsg] = useState('');

  const walletAddress = "TFFYftp65k6nL8Q2yZLZeTPMUAer2mK57F";

  useEffect(() => {
    if (pkState.timeLeft > 0 && pkState.active) {
      const timer = setInterval(() => {
        setPkState(prev => ({ ...prev, timeLeft: prev.timeLeft - 1 }));
      }, 1000);
      return () => clearInterval(timer);
    }
  }, [pkState.timeLeft, pkState.active]);

  const copyToClipboard = () => {
    navigator.clipboard.writeText(walletAddress);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const handleSendGift = (giftName, cost) => {
    if (coins < cost) {
      alert("Insufficient Eagle Coins! Recharge via CultureP MoMo or USDT.");
      return;
    }

    setCoins(prev => prev - cost);
    const hostEarnedPoints = Math.floor(cost * 0.8);

    if (targetHost === 1) {
      setPkState(prev => ({ ...prev, host1Points: prev.host1Points + hostEarnedPoints }));
    } else {
      setPkState(prev => ({ ...prev, host2Points: prev.host2Points + hostEarnedPoints }));
    }

    setShowGiftAnimation({ giftName, host: targetHost === 1 ? 'Sarah Live' : 'DJ Eagle' });
    setTimeout(() => setShowGiftAnimation(null), 3000);

    setMessages(prev => [
      ...prev,
      { id: Date.now(), user: 'You', text: `Sent ${giftName} to Host ${targetHost}! (+${hostEarnedPoints} pts)`, type: 'gift' }
    ]);
  };

  const handleSendMessage = (e) => {
    e.preventDefault();
    if (!inputMsg.trim()) return;
    setMessages(prev => [...prev, { id: Date.now(), user: 'You', text: inputMsg, type: 'chat' }]);
    setInputMsg('');
  };

  const handleSellerTransfer = (e) => {
    e.preventDefault();
    const amount = parseInt(transferAmount);
    if (!targetUserId || isNaN(amount) || amount <= 0) return;
    if (coins < amount) {
      alert("Not enough coins in seller agent balance!");
      return;
    }
    setCoins(prev => prev - amount);
    setTransferSuccess(true);
    setTimeout(() => setTransferSuccess(false), 4000);
    setTargetUserId('');
    setTransferAmount('');
  };

  const handleWithdrawalRequest = (e) => {
    e.preventDefault();
    const pts = parseInt(withdrawPoints);
    if (isNaN(pts) || pts < 5000) {
      alert("Minimum withdrawal requirement is 5,000 Points!");
      return;
    }
    if (pts > points) {
      alert("Points amount exceeds available earnings balance!");
      return;
    }

    setPoints(prev => prev - pts);
    setWithdrawSuccess(true);
    setTimeout(() => setWithdrawSuccess(false), 5000);
    setWithdrawPoints('');
    setWithdrawDetails('');
  };

  const totalPkPoints = pkState.host1Points + pkState.host2Points;
  const host1Pct = totalPkPoints > 0 ? Math.round((pkState.host1Points / totalPkPoints) * 100) : 50;

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
      <header className="bg-slate-900/90 border-b border-amber-500/20 px-4 py-3 flex justify-between items-center sticky top-0 z-50 backdrop-blur">
        <div className="flex items-center gap-2">
          <div className="bg-gradient-to-tr from-amber-500 to-yellow-300 p-2 rounded-xl text-slate-950 shadow-lg shadow-amber-500/20">
            <Crown className="w-6 h-6 font-bold" />
          </div>
          <div>
            <h1 className="font-bold text-lg bg-gradient-to-r from-amber-400 via-yellow-200 to-amber-500 bg-clip-text text-transparent">EAGLE LIVE</h1>
            <p className="text-[10px] text-amber-400/80 tracking-wider">OFFICIAL ESWATINI</p>
          </div>
        </div>

        <div className="flex items-center gap-2">
          <div className="bg-slate-800/80 border border-amber-500/30 px-3 py-1 rounded-full flex items-center gap-1.5 text-xs">
            <Zap className="w-3.5 h-3.5 text-amber-400 fill-amber-400" />
            <span className="font-semibold text-amber-300">{coins.toLocaleString()}</span>
          </div>
          <div className="bg-slate-800/80 border border-emerald-500/30 px-3 py-1 rounded-full flex items-center gap-1.5 text-xs">
            <Trophy className="w-3.5 h-3.5 text-emerald-400" />
            <span className="font-semibold text-emerald-300">{points.toLocaleString()}</span>
          </div>
        </div>
      </header>

      <main className="flex-1 max-w-md mx-auto w-full pb-20 pt-2 px-2">
        <div className="grid grid-cols-4 gap-1 bg-slate-900/80 p-1 rounded-xl mb-3 border border-slate-800 text-xs">
          <button onClick={() => setActiveTab('live')} className={`py-2 rounded-lg flex flex-col items-center gap-1 ${activeTab === 'live' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400'}`}><Tv className="w-4 h-4" /><span>PK Live</span></button>
          <button onClick={() => setActiveTab('recharge')} className={`py-2 rounded-lg flex flex-col items-center gap-1 ${activeTab === 'recharge' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400'}`}><CreditCard className="w-4 h-4" /><span>Recharge</span></button>
          <button onClick={() => setActiveTab('seller')} className={`py-2 rounded-lg flex flex-col items-center gap-1 ${activeTab === 'seller' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400'}`}><UserCheck className="w-4 h-4" /><span>CultureP</span></button>
          <button onClick={() => setActiveTab('withdraw')} className={`py-2 rounded-lg flex flex-col items-center gap-1 ${activeTab === 'withdraw' ? 'bg-amber-500 text-slate-950 font-bold' : 'text-slate-400'}`}><Wallet className="w-4 h-4" /><span>Agency</span></button>
        </div>

        {activeTab === 'live' && (
          <div className="space-y-3">
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-2 text-center relative overflow-hidden">
              <div className="flex justify-between items-center text-xs font-bold mb-1 px-1">
                <span className="text-red-400 flex items-center gap-1"><Flame className="w-3.5 h-3.5 fill-red-400" /> Host 1 ({pkState.host1Points} pts)</span>
                <span className="bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded text-[10px]">⏱️ {Math.floor(pkState.timeLeft / 60)}:{(pkState.timeLeft % 60).toString().padStart(2, '0')}</span>
                <span className="text-blue-400 flex items-center gap-1">Host 2 ({pkState.host2Points} pts) <Flame className="w-3.5 h-3.5 fill-blue-400" /></span>
              </div>
              <div className="w-full bg-slate-800 h-3 rounded-full overflow-hidden flex relative border border-slate-700">
                <div className="bg-gradient-to-r from-red-600 to-red-400 h-full transition-all duration-300" style={{ width: `${host1Pct}%` }} />
                <div className="bg-gradient-to-r from-blue-400 to-blue-600 h-full transition-all duration-300" style={{ width: `${100 - host1Pct}%` }} />
              </div>
            </div>

            <div className="relative grid grid-cols-2 gap-1 bg-black rounded-2xl overflow-hidden border border-amber-500/30 h-64 shadow-2xl">
              {showGiftAnimation && (
                <div className="absolute inset-0 z-30 bg-black/60 backdrop-blur-sm flex flex-col items-center justify-center animate-pulse-subtle">
                  <div className="bg-gradient-to-r from-amber-500 to-yellow-400 p-4 rounded-full text-slate-950 mb-2 shadow-2xl shadow-amber-500/50">
                    <Crown className="w-12 h-12" />
                  </div>
                  <h3 className="text-xl font-black text-amber-300 tracking-wider uppercase">{showGiftAnimation.giftName} BLAST!</h3>
                  <p className="text-xs text-white">Sent to <span className="font-bold text-amber-400">{showGiftAnimation.host}</span></p>
                </div>
              )}
              <div className="relative bg-slate-900 flex flex-col justify-end p-2 border-r border-slate-800">
                <div className="absolute top-2 left-2 bg-red-600/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Host 1 (Sarah)</div>
                <div className="text-center my-auto">
                  <div className="w-16 h-16 rounded-full bg-gradient-to-tr from-red-500 to-amber-500 p-1 mx-auto mb-1">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150" alt="Sarah" className="w-full h-full object-cover rounded-full" />
                  </div>
                  <p className="text-xs font-bold text-slate-200">Sarah Live</p>
                </div>
              </div>
              <div className="relative bg-slate-900 flex flex-col justify-end p-2">
                <div className="absolute top-2 right-2 bg-blue-600/80 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Host 2 (DJ Eagle)</div>
                <div className="text-center my-auto">
                  <div className="w-16 h-16 rounded-full bg-gradient-to-tr from-blue-500 to-cyan-500 p-1 mx-auto mb-1">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150" alt="DJ Eagle" className="w-full h-full object-cover rounded-full" />
                  </div>
                  <p className="text-xs font-bold text-slate-200">DJ Eagle</p>
                </div>
              </div>
            </div>

            <div className="flex gap-2 text-xs">
              <button onClick={() => setTargetHost(1)} className={`flex-1 py-1.5 rounded-lg font-bold border ${targetHost === 1 ? 'bg-red-500/20 border-red-500 text-red-400' : 'bg-slate-900 border-slate-800 text-slate-400'}`}>Send to Host 1</button>
              <button onClick={() => setTargetHost(2)} className={`flex-1 py-1.5 rounded-lg font-bold border ${targetHost === 2 ? 'bg-blue-500/20 border-blue-500 text-blue-400' : 'bg-slate-900 border-slate-800 text-slate-400'}`}>Send to Host 2</button>
            </div>

            <div className="bg-slate-900 border border-slate-800 rounded-2xl p-3">
              <div className="grid grid-cols-4 gap-2">
                {[
                  { name: 'Rose', cost: 100, icon: '🌹' },
                  { name: 'Crown', cost: 500, icon: '👑' },
                  { name: 'Sports Car', cost: 1000, icon: '🏎️' },
                  { name: 'Golden Eagle', cost: 2500, icon: '🦅' },
                ].map((g) => (
                  <button key={g.name} onClick={() => handleSendGift(g.name, g.cost)} className="bg-slate-800/80 border border-amber-500/20 p-2 rounded-xl flex flex-col items-center">
                    <span className="text-2xl mb-1">{g.icon}</span>
                    <span className="text-[10px] font-bold text-slate-200">{g.name}</span>
                    <span className="text-[9px] text-amber-400">{g.cost} Coins</span>
                  </button>
                ))}
              </div>
            </div>

            <div className="bg-slate-900/90 border border-slate-800 rounded-2xl p-3 flex flex-col h-32">
              <div className="flex-1 overflow-y-auto space-y-1.5 text-xs mb-2">
                {messages.map(m => (
                  <div key={m.id} className={`p-1.5 rounded-lg ${m.type === 'gift' ? 'bg-amber-500/10 text-amber-300 font-medium' : 'bg-slate-800/50 text-slate-300'}`}>
                    <span className="font-bold text-slate-100">{m.user}: </span>
                    <span>{m.text}</span>
                  </div>
                ))}
              </div>
              <form onSubmit={handleSendMessage} className="flex gap-1.5">
                <input type="text" value={inputMsg} onChange={(e) => setInputMsg(e.target.value)} placeholder="Type a comment..." className="flex-1 bg-slate-800 border border-slate-700 rounded-lg px-3 py-1 text-xs" />
                <button type="submit" className="bg-amber-500 text-slate-950 font-bold px-3 py-1 rounded-lg text-xs"><Send className="w-3.5 h-3.5" /></button>
              </form>
            </div>
          </div>
        )}

        {activeTab === 'recharge' && (
          <div className="space-y-4">
            <div className="grid grid-cols-3 gap-2">
              {[{ coins: 1000, price: 'E20.00' }, { coins: 3000, price: 'E50.00' }, { coins: 5000, price: 'E100.00' }].map((p, idx) => (
                <div key={idx} className="bg-slate-900 border border-slate-800 p-3 rounded-2xl text-center">
                  <Zap className="w-5 h-5 text-amber-400 mx-auto mb-1 fill-amber-400" />
                  <p className="font-bold text-amber-300 text-sm">{p.coins.toLocaleString()}</p>
                  <div className="mt-2 bg-amber-500 text-slate-950 font-black text-xs py-1 rounded-lg">{p.price}</div>
                </div>
              ))}
            </div>

            <div className="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
              <a href="https://culturepcoins.masikoshongwe.workers.dev/#coins" target="_blank" rel="noreferrer" className="w-full bg-yellow-500 text-slate-950 font-bold py-2.5 px-4 rounded-xl text-xs flex items-center justify-center gap-2">
                Open MoMo Payment Link <ExternalLink className="w-3.5 h-3.5" />
              </a>
              <div className="bg-slate-800 p-2.5 rounded-xl border border-slate-700 flex items-center justify-between text-xs">
                <span className="font-mono text-[11px] text-slate-300 truncate mr-2">{walletAddress}</span>
                <button onClick={copyToClipboard} className="bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-1 rounded flex items-center gap-1 text-[11px] font-bold shrink-0">
                  {copied ? <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                  {copied ? "Copied" : "Copy"}
                </button>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'seller' && (
          <div className="space-y-4">
            <div className="bg-slate-900 border border-amber-500/40 p-4 rounded-2xl text-center">
              <ShieldCheck className="w-6 h-6 text-amber-400 mx-auto mb-1" />
              <h2 className="text-base font-bold text-amber-300">Official Coin Seller: CultureP</h2>
              <p className="text-xs font-mono text-amber-400 mt-1">📞 +268 7650 9007</p>
            </div>

            <form onSubmit={handleSellerTransfer} className="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
              <h3 className="text-xs font-bold text-slate-200">Transfer Coins to User</h3>
              <input type="text" placeholder="Target User ID (e.g. 1002)" value={targetUserId} onChange={(e) => setTargetUserId(e.target.value)} className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs" />
              <input type="number" placeholder="Coin Amount" value={transferAmount} onChange={(e) => setTransferAmount(e.target.value)} className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs" />
              <button type="submit" className="w-full bg-amber-500 text-slate-950 font-bold py-2.5 rounded-xl text-xs">Transfer Coins Now</button>
              {transferSuccess && <div className="bg-emerald-500/20 p-2 rounded-xl text-emerald-300 text-xs">Coins credited to User ID {targetUserId}!</div>}
            </form>
          </div>
        )}

        {activeTab === 'withdraw' && (
          <div className="space-y-4">
            <div className="bg-slate-900 border border-emerald-500/30 p-4 rounded-2xl text-center">
              <h2 className="text-base font-bold text-emerald-400 mb-1">Agency Earnings & Payouts</h2>
              <p className="text-xs text-slate-400">Min Withdrawal: <strong className="text-emerald-300">5,000 Points</strong></p>
            </div>

            <form onSubmit={handleWithdrawalRequest} className="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
              <input type="number" placeholder="Points (Min 5,000)" value={withdrawPoints} onChange={(e) => setWithdrawPoints(e.target.value)} className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs" />
              <select value={withdrawMethod} onChange={(e) => setWithdrawMethod(e.target.value)} className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs">
                <option value="MoMo">MTN MoMo Eswatini</option>
                <option value="USDT">USDT (TRC20 Crypto)</option>
              </select>
              <input type="text" placeholder="Account Details" value={withdrawDetails} onChange={(e) => setWithdrawDetails(e.target.value)} className="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs" />
              <div className="bg-slate-950 p-2 rounded-xl text-[10px] text-slate-400 flex items-center gap-1.5">
                <Mail className="w-3.5 h-3.5 text-amber-400 shrink-0" />
                <span>Dispatches to: <strong className="text-amber-300">cultureptokens755@gmail.com</strong></span>
              </div>
              <button type="submit" className="w-full bg-emerald-500 text-slate-950 font-bold py-2.5 rounded-xl text-xs">Submit Withdrawal Request</button>
              {withdrawSuccess && <div className="bg-emerald-500/20 p-2 rounded-xl text-emerald-300 text-xs">Request dispatched to cultureptokens755@gmail.com!</div>}
            </form>
          </div>
        )}
      </main>
    </div>
  );
}
